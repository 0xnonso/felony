impl Copy for Entry {}

pub enum BracketMatch {
    Pending,
    InArena { pub match_id: u256 },
    Resolved {
        pub winner: u256,
        pub loser: u256,
    },
}

impl Copy for BracketMatch {}

impl BracketMatch {
    pub fn view(self) -> [u256; 4] {
        match self {
            Self::Pending => [0, 0, 0, 0],
            Self::InArena { match_id } => [1, 0, 0, match_id],
            Self::Resolved { winner, loser } => [2, winner, loser, 0],
        }
    }
}

pub struct Payout {
    pub value: u256,
    pub scale: u256,
    pub prizes: [u256; 3],
    pub bonus: u256,
    pub remainder: u256,
    pub fee: u256,
    pub unowned: u256,
}

impl Copy for Payout {}

