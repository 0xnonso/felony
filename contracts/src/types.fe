    pub words: StorageMap<u256, u256>,
    pub eligible: StorageMap<u256, u256>,
    pub payouts: StorageMap<u256, Payout>,
    pub fee_claimed: StorageMap<u256, bool>,
    pub credits: StorageMap<Address, u256>,
    pub liabilities: u256,
    pub owed_shares: u256,
}

pub enum OracleRequestState {
    Unknown,
    Pending,
    Ready,
}
impl Copy for OracleRequestState {}
impl OracleRequestState {
    pub fn is_ready(self) -> bool {
        match self {
            Self::Unknown => {
                assert!(false)
                false
            },
            Self::Pending => false,
            Self::Ready => true,
        }
    }
}
pub struct OracleRequest {
    pub state: OracleRequestState,
    pub consumer: Address,
    pub deadline: u256,
    pub word: u256,
}
impl Copy for OracleRequest {}
pub struct OracleStore {
    pub requests: StorageMap<u256, OracleRequest>,
    pub contexts: StorageMap<u256, bool>,
    pub consumers: StorageMap<Address, bool>,
    pub guard: Mutex<()>,
    pub fees: u256,
}
