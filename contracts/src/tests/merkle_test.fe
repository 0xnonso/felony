use ingot::merkle::{bracket_context, build_root, verify_pair}

#[test]
fn python_vector_4() {
    let context = bracket_context(31337, 123, 1, 0xabc123, 4, 4)
    assert!(
        context == 97890924192983120411833414781839841530950899447187018294202397743873314571262,
    )
    let root = build_root(0xabc123, 4, 4, context)
    assert!(
        root == 6335507036474837155890542450019615958470632298070296854616203696834073446080,
    )
    let siblings: [u256; 9] = [
        60842765451929384737471199227301194922240715576502952315074961219081428833263,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
    ]
    assert!(verify_pair(root, context, 4, 2, 2, 3, siblings))
    assert!(!verify_pair(root, context, 4, 3, 2, 3, siblings))
    assert!(!verify_pair(root, context, 4, 2, 3, 2, siblings))
    assert!(!verify_pair(root, context + 1, 4, 2, 2, 3, siblings))
    assert!(!verify_pair(root + 1, context, 4, 2, 2, 3, siblings))
}

#[test]
fn python_vector_5() {
    let context = bracket_context(31337, 123, 1, 0xabc123, 5, 8)
    assert!(
        context == 93963929718031432909661621900989853627147279338468173484700921615388438259356,
    )
    let root = build_root(0xabc123, 5, 8, context)
    assert!(
        root == 110881712590754643465078287040338259801864278905201354877504418356625182650190,
    )
    let siblings: [u256; 9] = [
        89097517349638896313404087821272109205706487165065311654072509779859152750047,
        112982068176363576672258117227031963320289428579415823894402463911836640517852,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
    ]
    assert!(verify_pair(root, context, 8, 4, 5, 2, siblings))
    assert!(!verify_pair(root, context, 8, 5, 5, 2, siblings))
    assert!(!verify_pair(root, context, 8, 4, 2, 5, siblings))
    assert!(!verify_pair(root, context + 1, 8, 4, 5, 2, siblings))
    assert!(!verify_pair(root + 1, context, 8, 4, 5, 2, siblings))
}

#[test]
fn python_vector_16() {
    let context = bracket_context(31337, 123, 1, 0xabc123, 16, 16)
    assert!(
        context == 107829678831389937621529040451369269350258589838101040353194293522575203809370,
    )
    let root = build_root(0xabc123, 16, 16, context)
    assert!(
        root == 99421664556442438011752089784467469376432359600856332137757983710365361518570,
    )
    let siblings: [u256; 9] = [
        93524074082686634027283011321511422654163059942169522934829426064858860231505,
        10247418708198719153553804333934929770297550868224883539868933473403847663823,
        16792622853807718349708342290949507794165124763011190711551712256806593939674,
        0,
        0,
        0,
        0,
        0,
        0,
    ]
    assert!(verify_pair(root, context, 16, 8, 11, 16, siblings))
    assert!(!verify_pair(root, context, 16, 9, 11, 16, siblings))
    assert!(!verify_pair(root, context, 16, 8, 16, 11, siblings))
    assert!(!verify_pair(root, context + 1, 16, 8, 11, 16, siblings))
    assert!(!verify_pair(root + 1, context, 16, 8, 11, 16, siblings))
}

#[test]
fn noncanonical_padding_is_rejected() {
    var siblings: [u256; 9] = [0; 9]
    siblings[0] = 60842765451929384737471199227301194922240715576502952315074961219081428833263
    siblings[8] = 1
    assert!(
        !verify_pair(
            6335507036474837155890542450019615958470632298070296854616203696834073446080,
            97890924192983120411833414781839841530950899447187018294202397743873314571262,
            4,
            2,
            2,
            3,
            siblings,
        ),
    )
}

#[test]
fn only_first_round_indices_are_accepted() {
    let siblings: [u256; 9] = [0; 9]
    assert!(!verify_pair(0, 0, 1024, 511, 1, 2, siblings))
    assert!(!verify_pair(0, 0, 1024, 1024, 1, 2, siblings))
    assert!(!verify_pair(0, 0, 2048, 1024, 1, 2, siblings))
    assert!(!verify_pair(0, 0, 0, 0, 1, 2, siblings))
}

#[test]
fn python_large_vector_513() {
    let context = bracket_context(31337, 123, 1, 0xabc123, 513, 1024)
    assert!(
        context == 99931224956692706849287111674837667427146998871996034519743670868531469370677,
    )
    let root = build_root(0xabc123, 513, 1024, context)
    assert!(
        root == 83965078772236977703902575186172677815058419029770006149745707376927569599682,
    )
    let siblings: [u256; 9] = [
        54326017400673899528732933640816949194712953517369477252123832811162717315095,
        58173470969651495985305160193969336817460659237440109106989547797446611606377,
        109577834978627047871843980181777261434855509259455298914032003687763165461939,
        3561276105139534244506476268648911442746940608016960718659025328514473949576,
        80680512308424296320383863650390834973501512450157129817918161966110548706564,
        15110577634345091647576252588480325007009575759351670981900463209752569966025,
        99885439341864179694304493265015344846141485716708600566003467515607668530737,
        42838520542270501553471934114983145161953439726467179949035089186169233130562,
        76633295630201031274886130939757176653380067766890943351982801989694778468508,
    ]
    assert!(verify_pair(root, context, 1024, 1023, 201, 0, siblings))
    assert!(!verify_pair(root, context, 1024, 1022, 201, 0, siblings))
}

#[test]
fn python_large_vector_1024() {
    let context = bracket_context(31337, 123, 1, 0xabc123, 1024, 1024)
    assert!(
        context == 77534488114799188980173788772290353663223452420625153024347715170479730742907,
    )
    let root = build_root(0xabc123, 1024, 1024, context)
    assert!(
        root == 59155959703163358515897625113621165247234081480607628560810539103083821804216,
    )
    let siblings: [u256; 9] = [
        8457664233425705659066729257039064458519995925979042220410328035980307849121,
        7187030184282381952395092130810369099359392137640417213352812166131014402032,
        49188999166229337777453904607460937991066811700891178047060477170752226781323,
        70037934073995018334728206962551801107220451974284702532293352061925063783877,
        84181582803736163129000046566655187428094572583099413361234594743353938900762,
        43385204313018532466480004987977746160560681601608231985007586868116150329866,
        61972565702271219149272346543840870541799100283990113130915046051838077048599,
        50894074788083643345357469883861891939510827414199228055584654177072567516994,
        8526037235987688944250765787550663407205436259529624855560468461402269269003,
    ]
    assert!(verify_pair(root, context, 1024, 1023, 804, 253, siblings))
    assert!(
        !verify_pair(root, context, 1024, 1022, 804, 253, siblings),
    )
}

#[test]
fn legacy_prefixed_tree_is_rejected() {
    let siblings: [u256; 9] = [
        51752828086785024730004287719427148321793529074014725300412230042808670100366,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
    ]
    assert!(
        !verify_pair(
            95713106716401066403639613318934894185201530628113546103472288655532005599169,
            bracket_context(31337, 123, 1, 0xabc123, 4, 4),
            4,
            2,
            2,
            3,
            siblings,
        ),
    )
}
