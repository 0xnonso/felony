use ingot::rules::{
    ALL_CARDS,
    Board,
    BoardOutcome,
    forced,
    holds,
    initial,
    loot_digest,
    outcome,
    tournament_outcome,
    packed,
    resolve,
    select_prize,
}

const SEED: u256 = 5

fn field(_ word: u256, _ shift: u256, _ bits: u256) -> u256 {
    (word >> shift) & ((1 << bits) - 1)
}

fn card_mask(_ card: u256) -> u256 {
    1 << (card - 1)
}

fn check_game(
    seed: u256,
    bids0: [u256; 9],
    bids1: [u256; 9],
    prizes: [u256; 9],
    packed0: [u256; 9],
    packed1: [u256; 9],
    score0: u256,
    score1: u256,
    result: u256,
) {
    var board = initial(seed)
    for i in 0 .. 9 {
        assert!(board.round == i as u256)
        assert!(board.current == prizes[i])
        assert!(packed(board, 0) == packed0[i])
        assert!(packed(board, 1) == packed1[i])
        if i == 8 {
            assert!(forced(board.hand0) == bids0[i])
            assert!(forced(board.hand1) == bids1[i])
        }
        board = resolve(board, bids0[i], bids1[i], seed)
    }
    assert!(board.score0 == score0)
    assert!(board.score1 == score1)
    match outcome(board) {
        BoardOutcome::Seat0Won => assert!(result == 1),
        BoardOutcome::Seat1Won => assert!(result == 2),
        BoardOutcome::Draw => assert!(result == 3),
    }
    assert!(
        board.hand0 == 0 && board.hand1 == 0 && board.loot == 0 && board.current == 0,
    )
}

fn board_with_prize(_ prize: u256) -> Board {
    var board = initial(SEED)
    board.current = prize
    board
}

#[test]
fn loot_digest_matches_abi_encoded_keccak() {
    assert!(
        loot_digest(5, 0) == 0x7e3f5420222a4452034d53688474840983a0d47ebe1072b65669968d66945564,
    )
}

#[test]
fn initial_board_is_full_and_uses_the_seed() {
    let board = initial(SEED)
    assert!(
        board.hand0 == ALL_CARDS && board.hand1 == ALL_CARDS && board.loot == ALL_CARDS,
    )
    assert!(board.score0 == 0 && board.score1 == 0 && board.round == 0)
    assert!(board.history0 == 0 && board.history1 == 0)
    assert!(board.current == select_prize(ALL_CARDS, SEED, 0))
    assert!(board.current >= 1 && board.current <= 9)
}

#[test]
fn prize_selection_only_returns_remaining_prizes() {
    let loot = card_mask(2) | card_mask(5) | card_mask(9)
    for round in 0 .. 64 {
        let prize = select_prize(loot, 77, round as u256)
        assert!(prize == 2 || prize == 5 || prize == 9)
    }
    assert!(select_prize(card_mask(7), 77, 3) == 7)
}

#[test]
fn packed_state_uses_the_specified_bit_layout() {
    var board = board_with_prize(3)
    board.hand0 = 0x1fe
    board.hand1 = 0x1fd
    board.loot = 0x1fb ^ card_mask(1) | card_mask(3)
    board.score0 = 2
    board.score1 = 9
    board.history0 = 0x5 << 0
    board.history1 = 0x6 << 0
    let seat0_view = packed(board, 0)
    assert!(field(seat0_view, 0, 9) == 0x1fe)
    assert!(field(seat0_view, 9, 9) == 0x1fd)
    assert!(field(seat0_view, 18, 9) == board.loot)
    assert!(field(seat0_view, 27, 4) == 3)
    assert!(field(seat0_view, 31, 7) == 38)
    assert!(field(seat0_view, 38, 36) == 5)
    assert!(field(seat0_view, 74, 36) == 6)
    assert!(seat0_view >> 110 == 0)
    let seat1_view = packed(board, 1)
    assert!(field(seat1_view, 0, 9) == 0x1fd)
    assert!(field(seat1_view, 9, 9) == 0x1fe)
    assert!(field(seat1_view, 31, 7) == 52)
    assert!(field(seat1_view, 38, 36) == 6)
    assert!(field(seat1_view, 74, 36) == 5)
}

#[test]
fn higher_bid_wins_the_prize_for_either_seat() {
    let board = board_with_prize(4)
    let seat0 = resolve(board, 7, 2, SEED)
    assert!(seat0.score0 == 4 && seat0.score1 == 0)
    let seat1 = resolve(board, 2, 7, SEED)
    assert!(seat1.score0 == 0 && seat1.score1 == 4)
}

#[test]
fn tie_burns_the_prize_and_spends_both_cards() {
    let next = resolve(board_with_prize(6), 3, 3, SEED)
    assert!(next.score0 == 0 && next.score1 == 0)
    assert!(next.hand0 == ALL_CARDS ^ card_mask(3))
    assert!(next.hand1 == ALL_CARDS ^ card_mask(3))
    assert!(next.loot == ALL_CARDS ^ card_mask(6))
}

#[test]
fn resolve_records_history_by_prize_and_advances() {
    let next = resolve(board_with_prize(9), 8, 1, SEED)
    assert!(field(next.history0, 32, 4) == 8)
    assert!(field(next.history1, 32, 4) == 1)
    assert!(next.history0 >> 36 == 0)
    assert!(next.round == 1)
    assert!(next.loot & card_mask(9) == 0)
    assert!(next.current == select_prize(next.loot, SEED, 1))
    assert!(next.loot & card_mask(next.current) != 0)
}

#[test]
fn resolve_leaves_the_input_board_unchanged() {
    let board = initial(SEED)
    let before = packed(board, 0)
    let _next = resolve(board, 1, 2, SEED)
    assert!(packed(board, 0) == before)
}

#[test]
fn identical_bids_finish_as_a_scoreless_draw() {
    var board = initial(SEED)
    for i in 0 .. 9 {
        let card = (i as u256) + 1
        board = resolve(board, card, card, SEED)
    }
    assert!(board.score0 == 0 && board.score1 == 0)
    assert!(
        match outcome(board) {
            BoardOutcome::Draw => true,
            _ => false,
        },
    )
}

#[test]
fn outcome_compares_final_scores() {
    var board = initial(SEED)
    board.round = 9
    board.score0 = 23
    board.score1 = 22
    assert!(
        match outcome(board) {
            BoardOutcome::Seat0Won => true,
            _ => false,
        },
    )
    board.score0 = 21
    assert!(
        match outcome(board) {
            BoardOutcome::Seat1Won => true,
            _ => false,
        },
    )
}

#[test]
fn forced_returns_the_single_card() {
    for i in 0 .. 9 {
        let card = (i as u256) + 1
        assert!(forced(card_mask(card)) == card)
    }
}

#[test]
fn holds_rejects_cards_outside_the_hand() {
    let hand = card_mask(1) | card_mask(9)
    assert!(holds(hand, 1) && holds(hand, 9))
    assert!(!holds(hand, 0) && !holds(hand, 2) && !holds(hand, 10))
    assert!(!holds(hand, 1 << 200))
}

#[test(should_revert)]
fn bid_zero_is_rejected() {
    let _ = resolve(initial(SEED), 0, 1, SEED)
}

#[test(should_revert)]
fn bid_ten_is_rejected() {
    let _ = resolve(initial(SEED), 1, 10, SEED)
}

#[test(should_revert)]
fn seat0_spent_card_is_rejected() {
    let next = resolve(initial(SEED), 4, 5, SEED)
    let _ = resolve(next, 4, 6, SEED)
}

#[test(should_revert)]
fn seat1_spent_card_is_rejected() {
    let next = resolve(initial(SEED), 4, 5, SEED)
    let _ = resolve(next, 6, 5, SEED)
}

fn finished_board() -> Board {
    var board = initial(SEED)
    for i in 0 .. 9 {
        let card = (i as u256) + 1
        board = resolve(board, card, card, SEED)
    }
    board
}

#[test(should_revert)]
fn finished_game_cannot_continue() {
    let _ = resolve(finished_board(), 1, 1, SEED)
}

#[test(should_revert)]
fn finished_game_has_no_packed_state() {
    let _ = packed(finished_board(), 0)
}

#[test(should_revert)]
fn unfinished_game_has_no_outcome() {
    let _ = outcome(initial(SEED))
}

#[test(should_revert)]
fn third_player_is_rejected() {
    let _ = packed(initial(SEED), 2)
}

#[test(should_revert)]
fn current_prize_must_remain_in_loot() {
    var board = initial(SEED)
    board.loot = board.loot ^ card_mask(board.current)
    let _ = packed(board, 0)
}

#[test(should_revert)]
fn forced_rejects_an_empty_hand() {
    let _ = forced(0)
}

#[test(should_revert)]
fn forced_rejects_two_cards() {
    let _ = forced(card_mask(1) | card_mask(2))
}

#[test(should_revert)]
fn forced_rejects_bits_outside_the_deck() {
    let _ = forced(1 << 9)
}

#[test(should_revert)]
fn selection_rejects_empty_loot() {
    let _ = select_prize(0, SEED, 0)
}

