#[test]
fn tournament_score_ties_use_highest_capture() {
    let a: [u256; 9] = [4, 1, 7, 6, 2, 5, 8, 3, 9]
    let b: [u256; 9] = [7, 6, 1, 4, 5, 8, 2, 3, 9]
    var board = initial(SEED)
    while board.round < 9 {
        let index: usize = (board.current - 1).downcast_unchecked()
        board = resolve(board, a[index], b[index], SEED)
    }
    assert!(board.score0 == 14 && board.score1 == 14)
    assert!(
        match outcome(board) {
            BoardOutcome::Draw => true,
            _ => false,
        },
    )
    assert!(
        match tournament_outcome(board) {
            BoardOutcome::Seat0Won => true,
            _ => false,
        },
    )

    board = initial(SEED)
    while board.round < 9 {
        let prize = board.current
        let other = if prize == 9 { 1 } else { prize + 1 }
        board = resolve(board, prize, other, SEED)
    }
    assert!(board.score0 == 9 && board.score1 == 36)
    assert!(
        match tournament_outcome(board) {
            BoardOutcome::Seat1Won => true,
            _ => false,
        },
    )
}

#[test]
fn tournament_all_burn_remains_drawn_for_controller_coin() {
    var board = initial(SEED)
    while board.round < 9 {
        let bid = board.round + 1
        board = resolve(board, bid, bid, SEED)
    }
    assert!(
        match tournament_outcome(board) {
            BoardOutcome::Draw => true,
            _ => false,
        },
    )
}
