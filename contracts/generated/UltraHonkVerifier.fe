pub mod commitments {
    // SPDX-License-Identifier: Apache-2.0
    // Port of pinned Aztec CommitmentScheme.sol and BaseZKHonkVerifier.verifyShplemini.
    use ingot::arrays::Buffer
    use ingot::field::{Fr, batch_invert, scalar_constant}
    use ingot::proof::{ParsedProof, Transcript}
    use ingot::types::{EncodedG1, MsmTerm}
    use ingot::verification_key::{MAX_LOG_N, MSM_CAPACITY, VerificationKey}
    use std::evm::{Call, Ctx}

    /// z - r, z + r, r, z - g*r, z - 1, and two per fold after the first.
    const OPENING_DENOMINATORS: usize = 2 * MAX_LOG_N + 3

    /// r^(2^i) for each fold i < log_n.
    pub fn squares(_ r: Fr, _ log_n: usize, _ powers: mut [Fr; MAX_LOG_N]) {
        powers[0] = r
        for i in 1 .. log_n {
            powers[i] = powers[i - 1] * powers[i - 1]
        }
    }

    /// Recover positive Gemini evaluations, working backwards through the folds.
    pub fn fold_evaluations(
        _ challenges: [Fr; MAX_LOG_N],
        _ batched_evaluation: Fr,
        _ negative_evaluations: [Fr; MAX_LOG_N],
        _ powers: [Fr; MAX_LOG_N],
        _ log_n: usize,
        _ positive: mut [Fr; MAX_LOG_N],
    )
    uses (call: Call, ctx: Ctx)
    {
        var denominators = Buffer<[Fr; MAX_LOG_N]>::new()
        let inverses = mut denominators.get()
        for i in 0 .. log_n {
            inverses[i] = powers[i] * (Fr::one() - challenges[i]) + challenges[i]
        }
        batch_invert(mut inverses, log_n)
        var accumulator = batched_evaluation
        var i = log_n
        while i > 0 {
            i -= 1
            let power = powers[i]
            let u = challenges[i]
            let numerator = power * accumulator * scalar_constant(2) -
                negative_evaluations[i] * (power * (Fr::one() - u) - u)
            accumulator = numerator * inverses[i]
            positive[i] = accumulator
        }
    }

    /// Write the ordered MSM terms for the combined Shplonk/Gemini/Libra opening claim.
    /// The first `42 + log_n` terms are used. Callers must also check Libra consistency.
    pub fn opening_terms(
        _ p: ParsedProof,
        _ vk: VerificationKey,
        _ t: Transcript,
        _ terms: mut [MsmTerm; MSM_CAPACITY],
    )
    uses (call: Call, ctx: Ctx)
    {
        // Fold powers r^(2^i) and positive evaluations A_i(r^(2^i)).
        var folds = Buffer<[[Fr; MAX_LOG_N]; 2]>::new()
        let fold = mut folds.get()
        squares(t.gemini_r, p.log_n, mut fold[0])
        let powers = ref fold[0]
        let generator = scalar_constant(
            0x07b0c561a6148404f086204a9f36ffb0617942546750f230c893619174a57a76,
        )
        // Every Shplonk denominator, inverted together: z - r, z + r, r, z - g*r,
        // z - 1, then z - r^(2^i), z + r^(2^i) for each later fold i.
        var denominators = Buffer<[Fr; OPENING_DENOMINATORS]>::new()
        let inverses = mut denominators.get()
        inverses[0] = t.shplonk_z - powers[0]
        inverses[1] = t.shplonk_z + powers[0]
        inverses[2] = t.gemini_r
        inverses[3] = t.shplonk_z - generator * t.gemini_r
        inverses[4] = t.shplonk_z - Fr::one()
        for i in 1 .. p.log_n {
            inverses[3 + 2 * i] = t.shplonk_z - powers[i]
            inverses[4 + 2 * i] = t.shplonk_z + powers[i]
        }
        batch_invert(mut inverses, 3 + 2 * p.log_n)
        let positive_inverse = inverses[0]
        let negative_inverse = inverses[1]
        let unshifted = -(positive_inverse + t.shplonk_nu * negative_inverse)
        let shifted = -(inverses[2] * (positive_inverse - t.shplonk_nu * negative_inverse))
        terms[0] = MsmTerm { point: p.shplonk_q, scalar: Fr::one() }
        terms[1].point = p.gemini_masking_poly
        for i in 0 .. 28 {
            terms[i + 2].point = vk.commitments[i]
        }
        let witness = [
            p.w1,
            p.w2,
            p.w3,
            p.w4,
            p.z_perm,
            p.lookup_inverses,
            p.lookup_read_counts,
            p.lookup_read_tags,
        ]
        for i in 0 .. 8 {
            terms[i + 30].point = witness[i]
        }
        var rho_power = Fr::one()
        var batched_evaluation = Fr::zero()
        for i in 0 .. 37 {
            terms[i + 1].scalar = unshifted * rho_power
            batched_evaluation = batched_evaluation + p.evaluations[i] * rho_power
            rho_power = rho_power * t.rho
        }
        for i in 0 .. 5 {
            terms[i + 30].scalar = terms[i + 30].scalar + shifted * rho_power
            batched_evaluation = batched_evaluation + p.evaluations[i + 37] * rho_power
            rho_power = rho_power * t.rho
        }
        fold_evaluations(
            t.sumcheck_challenges,
            batched_evaluation,
            p.gemini_a_evaluations,
            powers,
            p.log_n,
            mut fold[1],
        )
        let positive = ref fold[1]
        var constant_term = positive[0] * positive_inverse
            + p.gemini_a_evaluations[0] * t.shplonk_nu * negative_inverse
        var nu_power = t.shplonk_nu * t.shplonk_nu
        for i in 0 .. p.log_n - 1 {
            let positive_scale = nu_power * inverses[5 + 2 * i]
            let negative_scale = nu_power * t.shplonk_nu * inverses[6 + 2 * i]
            terms[38 + i] = MsmTerm {
                point: p.gemini_fold_comms[i],
                scalar: -positive_scale - negative_scale,
            }
            constant_term = constant_term
                + positive_scale * positive[i + 1]
                + negative_scale * p.gemini_a_evaluations[i + 1]
            nu_power = nu_power * t.shplonk_nu * t.shplonk_nu
        }
        // Five Libra claims: r, g*r, r, 1, r. Boundary claim at 1 has value zero.
        let libra_inverses = [
            positive_inverse,
            inverses[3],
            positive_inverse,
            inverses[4],
            positive_inverse,
        ]
        var scales = ingot::arrays::zero_array<Fr, 5>()
        for i in 0 .. 5 {
            let scale = libra_inverses[i] * nu_power
            scales[i] = -scale
            nu_power = nu_power * t.shplonk_nu
            if i != 3 {
                let index = if i < 3 { i } else { i - 1 }
                constant_term = constant_term + scale * p.libra_poly_evals[index]
            }
        }
        let boundary: usize = 37 + p.log_n
        terms[boundary] = MsmTerm { point: p.libra_commitments[0], scalar: scales[0] }
        terms[boundary + 1] = MsmTerm {
            point: p.libra_commitments[1],
            scalar: scales[1] + scales[2] + scales[3],
        }
        terms[boundary + 2] = MsmTerm { point: p.libra_commitments[2], scalar: scales[4] }
        terms[boundary + 3] = MsmTerm { point: EncodedG1::generator(), scalar: constant_term }
        terms[boundary + 4] = MsmTerm { point: p.kzg_quotient, scalar: t.shplonk_z }
    }
}

pub mod curve {
    use core::ops::Eq
    use core::result::Result
    use std::evm::{Address, Call, Ctx}
    use std::evm::crypto::{BN254_ADD_ADDRESS, BN254_MUL_ADDRESS, BN254_PAIRING_ADDRESS, addmod, mulmod}
    use ingot::field::{FQ_MODULUS, Fq, Fr}
    use ingot::types::{EncodedG1, EncodedG2}
    use core::abi::{load_word, store_word}
    use core::ptr::{self, FixedMemBuffer, MemSpan}

    pub enum CurveError {
        InvalidPoint,
        AddCallFailed,
        MulCallFailed,
        PairingCallFailed,
        InvalidPairingResult,
    }

    impl Copy for CurveError {}

    /// Canonical BN254 G1 point, including the EVM identity encoding (0,0).
    /// Private coordinates can only be obtained by validation or invariant-preserving operations.
    pub struct G1 { x: Fq, y: Fq }

    impl Copy for G1 {}

    /// One pairing term: checked G1 and canonically encoded, not yet checked G2.
    pub struct PairingTerm { pub g1: G1, pub g2: EncodedG2 }

    impl Copy for PairingTerm {}

    /// Check e(first.g1, first.g2) * e(second.g1, second.g2) == 1.
    /// Two terms match the pinned verifier. This does not construct its equation
    /// or supply the fixed SRS points; those belong to the final pairing stage.
    pub fn pairing_check(_ first: PairingTerm, _ second: PairingTerm) -> Result<CurveError, bool>
    uses (call: Call, ctx: Ctx)
    {
        let input = FixedMemBuffer<384>::alloc()
        unsafe {
            write_pair(input.ptr(), first)
            write_pair(ptr::offset_bytes(input.ptr(), 192), second)
        }
        var output = FixedMemBuffer<32>::alloc().into_buffer()
        let outcome = call
            .raw_staticcall(
                addr: Address::new(BN254_PAIRING_ADDRESS),
                gas: ctx.gas(),
                args: input.span(),
                ret: mut output,
            )
        if !outcome.success() {
            return Result::Err(CurveError::PairingCallFailed)
        }
        // Trust the known precompile's fixed output size. Match Solidity's strict
        // bool decoding, keeping a successful false distinct from call failure.
        match unsafe {
            load_word(output.ptr())
        } {
            0 => Result::Ok(false),
            1 => Result::Ok(true),
            _ => Result::Err(CurveError::InvalidPairingResult),
        }
    }

    /// destination must point to at least 192 writable bytes.
    #[inline(always)]
    unsafe fn write_pair(_ destination: *u8, _ term: PairingTerm) {
        store_word(ptr: destination, value: term.g1.x.to_word())
        store_word(
            ptr: ptr::offset_bytes(destination, 32),
            value: term.g1.y.to_word(),
        )
        store_word(
            ptr: ptr::offset_bytes(destination, 64),
            value: term.g2.x.imag.to_word(),
        )
        store_word(
            ptr: ptr::offset_bytes(destination, 96),
            value: term.g2.x.real.to_word(),
        )
        store_word(
            ptr: ptr::offset_bytes(destination, 128),
            value: term.g2.y.imag.to_word(),
        )
        store_word(
            ptr: ptr::offset_bytes(destination, 160),
            value: term.g2.y.real.to_word(),
        )
    }

    impl G1 {
        /// Private trusted-output decoder. output must point to 64 initialized bytes
        /// encoding a canonical curve point or identity, as guaranteed by a
        /// successful BN254 addition/multiplication precompile.
        #[inline(always)]
        unsafe fn from_precompile_output(_ output: *u8) -> Self {
            Self {
                x: Fq::from_canonical_word_unchecked(load_word(output)),
                y: Fq::from_canonical_word_unchecked(load_word(ptr::offset_bytes(output, 32))),
            }
        }

        /// Establish curve membership without an external call. EncodedG1 already
        /// guarantees canonical coordinates; (0,0) is the distinguished identity.
        pub fn from_encoded(_ point: EncodedG1) -> Result<CurveError, Self> {
            let x = point.x.to_word()
            let y = point.y.to_word()
            if x == 0 && y == 0 {
                return Result::Ok(Self { x: point.x, y: point.y })
            }
            let x_squared = mulmod(x, x, FQ_MODULUS)
            let rhs = addmod(mulmod(x_squared, x, FQ_MODULUS), 3, FQ_MODULUS)
            if mulmod(y, y, FQ_MODULUS) != rhs {
                return Result::Err(CurveError::InvalidPoint)
            }
            Result::Ok(Self { x: point.x, y: point.y })
        }

        pub fn to_encoded(self) -> EncodedG1 {
            EncodedG1 { x: self.x, y: self.y }
        }

        pub fn is_identity(self) -> bool {
            self.x.to_word() == 0 && self.y.to_word() == 0
        }

        pub fn negate(self) -> Self {
            Self { x: self.x, y: self.y.negate() }
        }

        pub fn add(self, _ other: Self) -> Result<CurveError, Self>
        uses (call: Call, ctx: Ctx)
        {
            let input = FixedMemBuffer<128>::alloc()
            unsafe {
                store_word(ptr: input.ptr(), value: self.x.to_word())
                store_word(
                    ptr: ptr::offset_bytes(input.ptr(), 32),
                    value: self.y.to_word(),
                )
                store_word(
                    ptr: ptr::offset_bytes(input.ptr(), 64),
                    value: other.x.to_word(),
                )
                store_word(
                    ptr: ptr::offset_bytes(input.ptr(), 96),
                    value: other.y.to_word(),
                )
            }
            call_point(BN254_ADD_ADDRESS, input.span())
        }

        /// Fr deliberately limits callers to canonical protocol scalars, although
        /// the raw EVM precompile accepts arbitrary u256 scalars.
        pub fn mul(self, _ scalar: Fr) -> Result<CurveError, Self>
        uses (call: Call, ctx: Ctx)
        {
            let input = FixedMemBuffer<96>::alloc()
            unsafe {
                store_word(ptr: input.ptr(), value: self.x.to_word())
                store_word(
                    ptr: ptr::offset_bytes(input.ptr(), 32),
                    value: self.y.to_word(),
                )
                store_word(
                    ptr: ptr::offset_bytes(input.ptr(), 64),
                    value: scalar.to_word(),
                )
            }
            call_point(BN254_MUL_ADDRESS, input.span())
        }
    }

    impl Eq for G1 {
        fn eq(self, _ other: Self) -> bool {
            self.x.to_word() == other.x.to_word() && self.y.to_word() == other.y.to_word()
        }
    }

    // Private to curve operations: each caller fixes its address and input layout.
    fn call_point(_ address: u256, _ input: MemSpan) -> Result<CurveError, G1>
    uses (call: Call, ctx: Ctx)
    {
        var output = FixedMemBuffer<64>::alloc().into_buffer()
        let outcome = call
            .raw_staticcall(
                addr: Address::new(address),
                gas: ctx.gas(),
                args: input,
                ret: mut output,
            )
        if !outcome.success() {
            return Result::Err(
                if address == BN254_ADD_ADDRESS {
                    CurveError::AddCallFailed
                } else {
                    CurveError::MulCallFailed
                },
            )
        }
        // Success at these fixed precompile addresses guarantees a canonical G1.
        Result::Ok(unsafe { G1::from_precompile_output(output.ptr()) })
    }

    use ingot::types::MsmTerm

    /// Every term is validated even when its scalar is zero, as in the reference.
    /// Terms that cannot change the sum skip the multiplication and addition.
    /// Sum of the first `len` terms; capacity is fixed, the count is runtime data.
    pub fn msm<const CAPACITY: usize>(_ terms: [MsmTerm; CAPACITY], _ len: usize) -> Result<
        CurveError,
        G1,
    >
    uses (call: Call, ctx: Ctx)
    {
        var accumulator = G1 {
            x: ingot::field::coordinate_constant(0),
            y: ingot::field::coordinate_constant(0),
        }
        for i in 0 .. len {
            let term = terms[i]
            let point = match G1::from_encoded(term.point) {
                Result::Ok(value) => value,
                Result::Err(error) => {
                    return Result::Err(error)
                },
            }
            // Identity point or zero scalar adds nothing: skip two precompile calls.
            if (term.point.x.to_word() | term.point.y.to_word()) == 0 || term.scalar == Fr::zero() {
                continue
            }
            let scaled = match point.mul(term.scalar) {
                Result::Ok(value) => value,
                Result::Err(error) => {
                    return Result::Err(error)
                },
            }
            accumulator = match accumulator.add(scaled) {
                Result::Ok(value) => value,
                Result::Err(error) => {
                    return Result::Err(error)
                },
            }
        }
        Result::Ok(accumulator)
    }
}

pub mod encoding {
    use core::result::Result
    use std::abi::Bytes
    use ingot::field::{Fq, Fr}
    use ingot::types::EncodedG1

    pub enum ProofReadError {
        UnexpectedEnd,
        NonCanonicalScalar,
        NonCanonicalCoordinate,
        TrailingBytes,
    }

    impl Copy for ProofReadError {}

    /// Owns the payload. Private cursor is always <= bytes.len().
    /// Every failed operation leaves the cursor unchanged, including a whole G1 read.
    pub struct ProofReader { bytes: Bytes, cursor: u256 }

    impl ProofReader {
        pub fn new(_ bytes: own Bytes) -> Self {
            Self { bytes, cursor: 0 }
        }

        pub fn position(self) -> u256 {
            self.cursor
        }

        pub fn remaining(self) -> u256 {
            self.bytes.len() as u256 - self.cursor
        }

        /// Useful for bounded section traversal; this does not validate skipped data.
        pub fn skip(mut self, _ width: u256) -> Result<ProofReadError, ()> {
            if width > self.remaining() {
                return Result::Err(ProofReadError::UnexpectedEnd)
            }
            self.cursor += width
            Result::Ok(())
        }

        /// Unrestricted big-endian word. No field reduction or range check.
        pub fn read_word(mut self) -> Result<ProofReadError, u256> {
            if self.remaining() < 32 {
                return Result::Err(ProofReadError::UnexpectedEnd)
            }
            let word = self.word_here()
            self.cursor += 32
            Result::Ok(word)
        }

        pub fn read_fr(mut self) -> Result<ProofReadError, Fr> {
            if self.remaining() < 32 {
                return Result::Err(ProofReadError::UnexpectedEnd)
            }
            match Fr::from_word(self.word_here()) {
                Result::Ok(value) => {
                    self.cursor += 32
                    Result::Ok(value)
                },
                Result::Err(_) => Result::Err(ProofReadError::NonCanonicalScalar),
            }
        }

        pub fn read_fq(mut self) -> Result<ProofReadError, Fq> {
            if self.remaining() < 32 {
                return Result::Err(ProofReadError::UnexpectedEnd)
            }
            match Fq::from_word(self.word_here()) {
                Result::Ok(value) => {
                    self.cursor += 32
                    Result::Ok(value)
                },
                Result::Err(_) => Result::Err(ProofReadError::NonCanonicalCoordinate),
            }
        }

        /// Two canonical coordinates; curve membership is a later boundary.
        /// In particular, the identity encoding (0,0) remains allowed.
        pub fn read_g1(mut self) -> Result<ProofReadError, EncodedG1> {
            if self.remaining() < 64 {
                return Result::Err(ProofReadError::UnexpectedEnd)
            }
            let x = match Fq::from_word(self.word_here()) {
                Result::Ok(value) => value,
                Result::Err(_) => {
                    return Result::Err(ProofReadError::NonCanonicalCoordinate)
                },
            }
            // The 64-byte check proves this offset fits usize and contains a full word.
            let y_word = self.bytes.word_at((self.cursor + 32).downcast_unchecked())
            let y = match Fq::from_word(y_word) {
                Result::Ok(value) => value,
                Result::Err(_) => {
                    return Result::Err(ProofReadError::NonCanonicalCoordinate)
                },
            }
            self.cursor += 64
            Result::Ok(EncodedG1 { x, y })
        }

        /// Call after the protocol's complete inventory has been read.
        pub fn finish(self) -> Result<ProofReadError, ()> {
            if self.remaining() == 0 {
                Result::Ok(())
            } else {
                Result::Err(ProofReadError::TrailingBytes)
            }
        }

        // Only called after checking at least 32 bytes remain. This also proves the
        // u256 cursor fits usize. Bytes.word_at would otherwise zero-pad a short word.
        fn word_here(self) -> u256 {
            self.bytes.word_at(self.cursor.downcast_unchecked())
        }
    }

    use ingot::proof::ProofBuffer
    use std::evm::revert_error
    use ingot::errors::{
        ValueGeLimbMax,
        ValueGeFieldOrder,
        ValueGeGroupOrder,
        ProofLengthWrong,
        ProofLengthWrongWithLogN,
    }

    /// Bytes in an UltraKeccakZKFlavor proof for a circuit of 2^log_n rows.
    pub fn proof_bytes(_ log_n: usize) -> usize {
        32 * (82 + 12 * log_n)
    }

    /// Decode the entire payload for a circuit of 2^log_n rows. Invalid encodings
    /// revert, as in Solidity loadProof. This establishes representation, not validity.
    #[inline(never)]
    pub fn decode_proof(_ bytes: own Bytes, _ log_n: usize) -> ProofBuffer {
        let expected = proof_bytes(log_n)
        if bytes.len() != expected {
            revert_error(
                ProofLengthWrongWithLogN {
                    logN: log_n as u256,
                    actualLength: bytes.len() as u256,
                    expectedLength: expected as u256,
                },
            )
        }
        var reader = ProofReader::new(bytes)
        var decoded = ProofBuffer::new()
        let p = mut decoded.get()
        p.log_n = log_n
        for i in 0 .. 8 {
            let word = match reader.read_word() {
                Result::Ok(value) => value,
                Result::Err(_) => revert_error(ProofLengthWrong {}),
            }
            let bits: u256 = if i % 2 == 0 { 136 } else { 120 }
            if word >= 1 << bits {
                revert_error(ValueGeLimbMax {})
            }
            p.accumulator[i] = ingot::field::scalar_constant(word)
        }
        p.gemini_masking_poly = point(mut reader)
        p.w1 = point(mut reader)
        p.w2 = point(mut reader)
        p.w3 = point(mut reader)
        p.lookup_read_counts = point(mut reader)
        p.lookup_read_tags = point(mut reader)
        p.w4 = point(mut reader)
        p.lookup_inverses = point(mut reader)
        p.z_perm = point(mut reader)
        p.libra_commitments[0] = point(mut reader)
        p.libra_sum = scalar(mut reader)
        for i in 0 .. log_n {
            for j in 0 .. 9 {
                p.sumcheck_univariates[i][j] = scalar(mut reader)
            }
        }
        for i in 0 .. 42 {
            p.evaluations[i] = scalar(mut reader)
        }
        p.libra_evaluation = scalar(mut reader)
        p.libra_commitments[1] = point(mut reader)
        p.libra_commitments[2] = point(mut reader)
        for i in 0 .. log_n - 1 {
            p.gemini_fold_comms[i] = point(mut reader)
        }
        for i in 0 .. log_n {
            p.gemini_a_evaluations[i] = scalar(mut reader)
        }
        for i in 0 .. 4 {
            p.libra_poly_evals[i] = scalar(mut reader)
        }
        p.shplonk_q = point(mut reader)
        p.kzg_quotient = point(mut reader)
        if reader.finish().is_err() {
            revert_error(ProofLengthWrong {})
        }
        decoded
    }

    fn scalar(_ reader: mut ProofReader) -> Fr {
        match reader.read_fr() {
            Result::Ok(value) => value,
            Result::Err(ProofReadError::NonCanonicalScalar) => revert_error(ValueGeFieldOrder {}),
            Result::Err(_) => revert_error(ProofLengthWrong {}),
        }
    }

    fn point(_ reader: mut ProofReader) -> EncodedG1 {
        match reader.read_g1() {
            Result::Ok(value) => value,
            Result::Err(ProofReadError::NonCanonicalCoordinate) => revert_error(ValueGeGroupOrder {}),
            Result::Err(_) => revert_error(ProofLengthWrong {}),
        }
    }
}

pub mod entities {
    // Pinned HonkTypes.WIRE indices. ZK proof evaluations add a masking slot at 0.
    pub const SIGMA_1: usize = 0
    pub const SIGMA_2: usize = 1
    pub const SIGMA_3: usize = 2
    pub const SIGMA_4: usize = 3
    pub const ID_1: usize = 4
    pub const ID_2: usize = 5
    pub const ID_3: usize = 6
    pub const ID_4: usize = 7
    pub const LAGRANGE_FIRST: usize = 8
    pub const LAGRANGE_LAST: usize = 9
    pub const Q_LOOKUP: usize = 10
    pub const TABLE_1: usize = 11
    pub const TABLE_2: usize = 12
    pub const TABLE_3: usize = 13
    pub const TABLE_4: usize = 14
    pub const Q_M: usize = 15
    pub const Q_R: usize = 16
    pub const Q_O: usize = 17
    pub const Q_C: usize = 18
    pub const Q_L: usize = 19
    pub const Q_4: usize = 20
    pub const Q_ARITH: usize = 21
    pub const Q_RANGE: usize = 22
    pub const Q_ELLIPTIC: usize = 23
    pub const Q_MEMORY: usize = 24
    pub const Q_NNF: usize = 25
    pub const Q_POSEIDON2_EXTERNAL: usize = 26
    pub const Q_POSEIDON2_INTERNAL: usize = 27
    pub const W_L: usize = 28
    pub const W_R: usize = 29
    pub const W_O: usize = 30
    pub const W_4: usize = 31
